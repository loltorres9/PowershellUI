<Window x:Class="PowerShellUI.App.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profil bearbeiten" Height="480" Width="460" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Profilname" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

        <TextBlock Grid.Row="2" Text="Werte (Parametername = Wert, z. B. TenantId, ClientId, AdminUrl)"
                   TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6" />

        <Border Grid.Row="3" BorderBrush="#D0D4DA" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Parametername" />
                                <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Wert" />
                                <Button Grid.Column="3" Content="✕" Padding="8,2" Margin="6,0,0,0"
                                        Command="{Binding RemoveCommand}" ToolTip="Zeile entfernen" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="4" Content="+ Wert hinzufügen" Command="{Binding AddEntryCommand}"
                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" />

        <TextBlock Grid.Row="5" Margin="0,14,0,0" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.7"
                   Text="Unverschlüsselt lokal gespeichert – keine Kennwörter/Client-Secrets hier ablegen." />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Abbrechen" Click="Cancel_Click" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Speichern" Click="Ok_Click" Padding="14,6" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
