<Window x:Class="PowerShellUI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PowerShellUI.App.ViewModels"
        Title="PowerShellUI" Height="720" Width="1100" MinWidth="800" MinHeight="500">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedScripts" Source="{Binding Scripts}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate x:Key="TextParameterTemplate">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Content="merken" Margin="8,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsRemembered}"
                              ToolTip="Wert lokal speichern und beim nächsten Mal automatisch vorausfüllen (unverschlüsselt, keine Kennwörter/Secrets)" />
                    <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding HelpMessage}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SwitchParameterTemplate">
            <StackPanel Margin="0,4" Orientation="Horizontal">
                <CheckBox IsChecked="{Binding SwitchValue}" Content="{Binding DisplayLabel}" ToolTip="{Binding HelpMessage}" />
                <CheckBox Content="merken" Margin="12,0,0,0" IsChecked="{Binding IsRemembered}"
                          ToolTip="Wert lokal speichern und beim nächsten Mal automatisch vorausfüllen" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceParameterTemplate">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Content="merken" Margin="8,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsRemembered}"
                              ToolTip="Wert lokal speichern und beim nächsten Mal automatisch vorausfüllen" />
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" ToolTip="{Binding HelpMessage}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <vm:ParameterTemplateSelector x:Key="ParameterTemplateSelector"
                                       TextTemplate="{StaticResource TextParameterTemplate}"
                                       SwitchTemplate="{StaticResource SwitchParameterTemplate}"
                                       ChoiceTemplate="{StaticResource ChoiceParameterTemplate}" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Durchsuchen..." Margin="6,0,0,0" Command="{Binding BrowseLibraryCommand}" />
            <Button DockPanel.Dock="Right" Content="Neu laden" Margin="6,0,0,0" Command="{Binding LoadLibraryCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="Skript-Bibliothek:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding LibraryPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Source={StaticResource GroupedScripts}}"
                         SelectedItem="{Binding SelectedScript}"
                         DisplayMemberPath="Name">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Background="#EEEEEE" Padding="4,2" Margin="0,4,0,0" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <Expander Grid.Row="1" Header="Gespeicherte Werte" Margin="0,8,0,0">
                    <StackPanel MaxHeight="180">
                        <TextBlock Text="Unverschlüsselt lokal gespeichert – keine Kennwörter/Secrets."
                                   TextWrapping="Wrap" FontStyle="Italic" Opacity="0.7" Margin="0,0,0,4" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
                            <ItemsControl ItemsSource="{Binding SavedValues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="✕" Padding="4,0"
                                                    Command="{Binding RemoveCommand}" ToolTip="Vergessen" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="110" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Expander>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="PowerShell-Version:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="260" ItemsSource="{Binding Editions}" SelectedItem="{Binding SelectedEdition}" DisplayMemberPath="Label" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding SelectedScript.Synopsis}" TextWrapping="Wrap" Margin="0,0,0,8" FontStyle="Italic" />

                <Expander Grid.Row="2" Header="Benötigte Module" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding RequiredModules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="{Binding DisplayName}" Width="220" />
                                        <TextBlock Text="{Binding StatusText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Fehlende Module installieren"
                                Command="{Binding InstallMissingModulesCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Expander>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Parameters}"
                                  ItemTemplateSelector="{StaticResource ParameterTemplateSelector}" />
                </ScrollViewer>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8">
                    <Button Content="Skript ausführen" Command="{Binding RunScriptCommand}" Padding="12,4" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <Border Grid.Row="5" BorderBrush="#CCCCCC" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OutputLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
